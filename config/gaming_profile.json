{
  "schemaVersion": "1.0.0",
  "profile": "core-gaming",
  "title": "Tiny11 Core-Gaming",
  "description": "Experimental, AtlasOS-inspired settings for disposable VM/Lab gaming tests. This profile removes security, servicing and compatibility features; no FPS, latency, RAM or CPU improvement is claimed or benchmark-validated.",
  "hivePrefixes": {
    "SYSTEM": "HKLM\\zSYSTEM",
    "SOFTWARE": "HKLM\\zSOFTWARE",
    "DEFAULT": "HKLM\\zDEFAULT",
    "NTUSER": "HKLM\\zNTUSER"
  },
  "defaultGroups": {
    "atlas_power_scheme": true,
    "disable_cpu_idle": true,
    "disable_security_mitigations": true,
    "remove_xbox_gaming_stack": true,
    "strip_background_noise": true,
    "instant_windows": true,
    "disable_fast_startup": true,
    "network_latency_tweaks": true,
    "disable_mpo": true,
    "latency_input_tweaks": true,
    "interrupt_latency": true,
    "disable_fso": true,
    "disable_game_mode": true,
    "disable_printing": true
  },
  "groupDescriptions": {
    "atlas_power_scheme": "Custom AtlasOS-style power scheme, imported and activated at first boot.",
    "disable_cpu_idle": "Request CPU C-State 0 and performance-favoring power-plan values. Raises idle power/temperature; hardware behavior varies and no performance gain is guaranteed.",
    "disable_security_mitigations": "Turn off VBS, HVCI, Credential Guard, System Guard and Spectre/Meltdown mitigations.",
    "remove_xbox_gaming_stack": "Remove Xbox Live / Gaming Services stack and Xbox AppX packages.",
    "strip_background_noise": "Disable Windows Search indexing, Bluetooth, Delivery Optimization, background apps, visual effects and scripted diagnostics, and turn off memory compression on machines with 16 GB or more.",
    "instant_windows": "Change selected window/menu/hover and application-shutdown settings. Slow applications may be terminated before saving; no responsiveness gain is guaranteed.",
    "disable_fast_startup": "Disable hibernation and Fast Startup (Hiberboot).",
    "network_latency_tweaks": "Change selected TCP, QoS, Delivery Optimization and Windows Update restart settings; no latency or throughput improvement is guaranteed.",
    "disable_mpo": "Request Multi-Plane Overlay off as a driver-specific troubleshooting experiment; it may help, do nothing, or regress display behavior.",
    "latency_input_tweaks": "Change mouse, accessibility, USB and windowed-presentation settings. Effects and compatibility vary by hardware and application; no latency improvement is guaranteed.",
    "interrupt_latency": "Apply per-device MSI/priority, NIC and USB/HID settings at first boot. Changes are hardware-specific, unbenchmarked and may cause driver or network regressions.",
    "disable_fso": "Request Fullscreen Optimizations off; test game and display-driver compatibility.",
    "disable_game_mode": "Disable Windows Game Mode. Scheduling and compatibility effects vary by game; no performance result is claimed.",
    "disable_printing": "Disable print spooler services and remove the printing optional features."
  },
